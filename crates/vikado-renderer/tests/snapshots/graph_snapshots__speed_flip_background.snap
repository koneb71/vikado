[0:v]trim=start=1:end=9,setpts=(PTS-STARTPTS)/2,fps=30,hflip,format=rgba,scale=w='min(1920/iw\,1080/ih)*iw*1':h='min(1920/iw\,1080/ih)*ih*1':eval=init,setpts=PTS+0/TB[c0];
[1:v]trim=start=0:end=0.5,setpts=(PTS-STARTPTS)/0.25,fps=30,vflip,format=rgba,scale=w='min(1920/iw\,1080/ih)*iw*1':h='min(1920/iw\,1080/ih)*ih*1':eval=init,setpts=PTS+4/TB[c1];
color=c=0x1a2b3c:s=1920x1080:r=30:d=6[base0];
[base0][c0]overlay=x='(main_w-overlay_w)/2+0':y='(main_h-overlay_h)/2+0':eof_action=pass:enable='between(t,0,4)'[base1];
